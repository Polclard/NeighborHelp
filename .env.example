SPRING_PROFILES_ACTIVE=dev

DB_NAME=neighborhelp
DB_USERNAME=postgres
DB_PASSWORD=postgres

HOST_FRONTEND_PORT=3000
HOST_BACKEND_PORT=8080
HOST_DB_PORT=5433
HOST_MAILPIT_SMTP_PORT=1025
HOST_MAILPIT_UI_PORT=8025

JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000

OPENROUTESERVICE_API_KEY=replace-me

# --- Image storage ---------------------------------------------------------
# "local" (default) writes uploads to APP_UPLOAD_DIR and serves them from
# /uploads/**. Good for development; it does NOT survive a redeploy on a host
# without a persistent volume.
#
# "cloudinary" uploads to Cloudinary and stores the delivery URL instead.
#
# Leave APP_STORAGE_PROVIDER unset: filling in the three Cloudinary values below
# selects Cloudinary on its own. Set it only to force one provider or the other.
# Get the values from the dashboard after signing up at
# https://cloudinary.com/users/register_free
# APP_STORAGE_PROVIDER=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=neighborhelp

# --- Production only -------------------------------------------------------
# Set these on the host that runs the backend (Render, Railway, Fly.io, a VPS,
# ...) when the SPA is served from Vercel. See docs/DEPLOYMENT.md.
#
# SPRING_PROFILES_ACTIVE=prod
#
# Point the API at the managed Postgres. Either supply a full JDBC URL:
#   DATABASE_URL=jdbc:postgresql://host:5432/neighborhelp?sslmode=require
# or leave DATABASE_URL unset and use the discrete DB_HOST/DB_PORT/DB_NAME vars.
# DB_HOST=
# DB_PORT=5432
#
# The browser only returns the refresh cookie to a different site when it is
# marked SameSite=None + Secure. The prod profile already defaults to that;
# override only if the API and the SPA end up on the same site.
# APP_REFRESH_COOKIE_SECURE=true
# APP_REFRESH_COOKIE_SAME_SITE=None
#
# Must list the exact Vercel origin, scheme included, no trailing slash:
# APP_CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# APP_WEBSOCKET_ALLOWED_ORIGINS=https://your-app.vercel.app
#
# Image storage. Prefer Cloudinary in production: free-tier hosts rarely offer
# a persistent volume, so the "local" provider loses every upload on redeploy.
# Setting these three is enough; APP_STORAGE_PROVIDER stays unset.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
#
# Only used when storage resolves to local. Point it at a persistent volume,
# otherwise every redeploy loses the uploads.
# APP_UPLOAD_DIR=/var/neighborhelp/uploads
