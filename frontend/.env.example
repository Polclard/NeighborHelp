# Base URL of the NeighborHelp backend. No trailing slash.
# Local development against docker-compose:
VITE_API_BASE_URL=http://localhost:8080

# Base URL used to open the SockJS/STOMP connection. Usually identical to
# VITE_API_BASE_URL; it falls back to that value when left unset.
VITE_WS_BASE_URL=http://localhost:8080

# On Vercel these are set in Project Settings -> Environment Variables and must
# point at the deployed backend over HTTPS, for example:
#   VITE_API_BASE_URL=https://neighborhelp-api.onrender.com
#   VITE_WS_BASE_URL=https://neighborhelp-api.onrender.com
#
# Vite inlines these at build time, so changing them in Vercel requires a
# redeploy before the new value reaches the browser.
